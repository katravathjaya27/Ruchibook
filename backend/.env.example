# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/ruchibook
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/ruchibook
MONGODB_URI=

# Any long random string. Used to sign login tokens (JWT).
JWT_SECRET=

# Port the backend server will run on
PORT=5000

# URL of the running frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: password for the auto-created admin@ruchibook.com account.
# If left blank, defaults to "admin123" -- change it after first login
# either way.
ADMIN_PASSWORD=
